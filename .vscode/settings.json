{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "pdflatex-clean",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-jobname=%DOCFILE%_clean", "\\def\\FINAL{}\\input{%DOC%}"]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "bibtex-clean",
      "command": "bibtex",
      "args": ["%DOCFILE%_clean"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "marked (tracked changes)",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "clean (accepted text only)",
      "tools": ["pdflatex-clean", "bibtex-clean", "pdflatex-clean", "pdflatex-clean"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "never"
}
